{
  "schema": 2,
  "permissions": [
    "tools.invoke",
    "chat.write_message",
    "llm.complete",
    "storage.read",
    "storage.write",
    "ui.svg"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:cmc-screener",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "The user has CMC Alpha Terminal open. Whenever the user inquires about cryptocurrency prices, Bitcoin/Ethereum/Solana trends, market volatility, liquidity depth, or alpha opportunities, proactively use the screener Executa with method='screener' and arguments {action:'momentum'|'volatility'|'liquidity'|'breadth'|'quote'} to fetch real-time quantitative metrics before answering.",
  "user_message_prefix_template": "[CMC Terminal] {user_message}",
  "tags": [
    "crypto",
    "finance",
    "quantitative",
    "screener",
    "alpha",
    "bitcoin",
    "solana",
    "trading",
    "terminal",
    "market",
    "volatility",
    "momentum",
    "defi",
    "data"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "CMC Alpha Terminal",
        "default": true,
        "entry": "index.html",
        "mobile_entry": "index.html",
        "min_size": {
          "w": 820,
          "h": 560
        },
        "default_size": {
          "w": 1020,
          "h": 740
        },
        "max_size": {
          "w": 1400,
          "h": 1050
        },
        "resizable": true,
        "movable": true,
        "single_instance": true,
        "icon": "icon.svg"
      }
    ],
    "host_api": {
      "tools": [
        "required:bundled:cmc-screener"
      ],
      "chat": [
        "write_message"
      ],
      "llm": [
        "complete"
      ],
      "artifact": [],
      "fs": [],
      "storage": [
        "get",
        "set"
      ],
      "prefs": [],
      "window": [
        "set_title"
      ]
    },
    "csp_overrides": {
      "img-src": [
        "'self'",
        "data:",
        "blob:"
      ],
      "font-src": [
        "'self'",
        "data:"
      ],
      "style-src": [
        "'self'"
      ],
      "script-src": [
        "'self'"
      ]
    },
    "state_merge": "last_writer_wins",
    "form_factors": [
      "desktop",
      "mobile"
    ]
  },
  "dev": {
    "fixtures": [],
    "seed_storage": {},
    "user_id": 1
  }
}